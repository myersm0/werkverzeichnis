{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/myersm0/werkverzeichnis/schemas/catalog.schema.json",
	"title": "Catalog",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name", "canonical_format", "pattern", "sort_keys"],
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9-]+$",
			"description": "Identifier used as scheme in catalog entries"
		},
		"name": {
			"type": "string",
			"description": "Full name of the catalog"
		},
		"description": {"type": "string"},
		"canonical_format": {
			"type": "string",
			"description": "Display format with {number} placeholder"
		},
		"pattern": {
			"type": "string",
			"description": "Regex pattern for parsing numbers. Use capture groups for sortable components."
		},
		"sort_keys": {
			"type": "array",
			"description": "How to sort based on captured groups",
			"items": {"$ref": "#/$defs/sortKey"}
		},
		"group_by": {
			"type": "array",
			"items": {"type": "integer", "minimum": 1},
			"description": "Capture groups that define a work group (for 'show me all of op 2')"
		},
		"examples": {
			"type": "array",
			"items": {"$ref": "#/$defs/example"}
		},
		"aliases": {
			"type": "array",
			"items": {"type": "string"},
			"description": "Alternative identifiers that resolve to this catalog"
		},
		"editions": {
			"type": "object",
			"additionalProperties": {"$ref": "#/$defs/edition"}
		},
		"current_edition": {
			"type": "string",
			"description": "Edition used when no edition is specified"
		},
		"categories": {
			"type": "object",
			"additionalProperties": {"type": "string"}
		},
		"constraints": {
			"type": "array",
			"description": "Structural constraints on parsed capture groups",
			"items": {"$ref": "#/$defs/catalogConstraint"}
		},
		"mb_format": {"type": "string"},
		"mb_part_format": {"type": "string"}
	},
	"$defs": {
		"sortKey": {
			"type": "object",
			"additionalProperties": false,
			"required": ["group", "type"],
			"properties": {
				"group": {"type": "integer", "minimum": 1},
				"type": {"type": "string", "enum": ["int", "str", "roman"]},
				"display": {"type": "string", "enum": ["upper", "lower", "title"]},
				"none_last": {
					"type": "boolean",
					"default": false,
					"description": "If true, missing/null values sort last instead of first"
				}
			}
		},
		"example": {
			"type": "object",
			"additionalProperties": false,
			"required": ["number", "display"],
			"properties": {
				"number": {"type": "string"},
				"display": {"type": "string"}
			}
		},
		"catalogConstraint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["group"],
			"properties": {
				"group": {"type": "integer", "minimum": 1},
				"name": {"type": "string"},
				"min": {"type": "integer"},
				"max": {"type": "integer"},
				"ranges": {
					"type": "array",
					"minItems": 1,
					"items": {"$ref": "#/$defs/intRange"}
				}
			}
		},
		"intRange": {
			"type": "object",
			"additionalProperties": false,
			"required": ["min", "max"],
			"properties": {
				"min": {"type": "integer"},
				"max": {"type": "integer"}
			}
		},
		"edition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["year", "editor"],
			"properties": {
				"year": {"type": "integer"},
				"editor": {"type": "string"}
			}
		}
	}
}
