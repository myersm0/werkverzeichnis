{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/myersm0/werkverzeichnis/schemas/collection.schema.json",
	"title": "Collection",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "title", "scheme", "compositions"],
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9-]+$",
			"description": "URL-friendly identifier"
		},
		"title": {
			"type": "object",
			"description": "Multilingual title dict",
			"additionalProperties": {"type": "string"},
			"minProperties": 1
		},
		"expansion_pattern": {
			"type": "object",
			"description": "Multilingual pattern for generating titles. Variables: {form}, {key}, {num}, {catalog}, {instrumentation}",
			"additionalProperties": {"type": "string"}
		},
		"composer": {
			"type": "string",
			"description": "Composer slug (simple case)"
		},
		"attribution": {
			"type": "array",
			"description": "Shared attribution for all compositions in collection (complex case)",
			"items": {"$ref": "#/$defs/attributionEntry"}
		},
		"scheme": {
			"type": "string",
			"description": "Catalog scheme for compositions in this collection"
		},
		"description": {"type": "string"},
		"compositions": {
			"type": "array",
			"description": "Ordered list of catalog numbers",
			"items": {"type": "string"}
		}
	},
	"$defs": {
		"attributionEntry": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"composer": {"type": "string"},
				"cf": {"type": "string"},
				"dates": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"composed": {"type": "integer"},
						"published": {"type": "integer"},
						"premiered": {"type": "integer"},
						"revised": {"type": "integer"}
					}
				},
				"status": {
					"type": "string",
					"enum": ["certain", "probable", "doubtful", "spurious"]
				},
				"catalog": {
					"type": "array",
					"items": {"$ref": "#/$defs/catalogEntry"}
				},
				"since": {
					"type": "string",
					"pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
				},
				"note": {"type": "string"}
			}
		},
		"catalogEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scheme", "number"],
			"properties": {
				"scheme": {"type": "string"},
				"number": {"type": "string"},
				"edition": {"type": "string"},
				"since": {
					"type": "string",
					"pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
				},
				"note": {"type": "string"}
			}
		}
	}
}
